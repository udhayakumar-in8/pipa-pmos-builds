diff --git a/device/testing/device-xiaomi-pipa/81-libssc-xiaomi-pipa.rules b/device/testing/device-xiaomi-pipa/81-libssc-xiaomi-pipa.rules
index 2bad473..16b3fc4 100644
--- a/device/testing/device-xiaomi-pipa/81-libssc-xiaomi-pipa.rules
+++ b/device/testing/device-xiaomi-pipa/81-libssc-xiaomi-pipa.rules
@@ -1,3 +1,8 @@
 # iio-sensor-proxy with libssc: accelerometer mount matrix
 
 SUBSYSTEM=="misc", KERNEL=="fastrpc-*", ENV{ACCEL_MOUNT_MATRIX}+="-1, 0, 0; 0, -1, 0; 0, 0, -1"
+
+# Only expose the accelerometer: light/proximity/compass make iio-sensor-proxy
+# crash on this device, which also kills auto-rotation. Unlike the iio-hack
+# post-install sed, this survives iio-sensor-proxy upgrades.
+SUBSYSTEM=="misc", KERNEL=="fastrpc-*", ENV{IIO_SENSOR_PROXY_TYPE}="ssc-accel"
